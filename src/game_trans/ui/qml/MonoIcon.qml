import QtQuick

// Minimalist monochrome vector icon set matching Google Gemini / Antigravity desktop aesthetics.
Canvas {
    id: root
    width: 18
    height: 18
    property string name: "sparkle"
    property color iconColor: Theme.textSecondary
    property real strokeWidth: 1.65

    onNameChanged: requestPaint()
    onIconColorChanged: requestPaint()
    onStrokeWidthChanged: requestPaint()
    onWidthChanged: requestPaint()
    onHeightChanged: requestPaint()
    onVisibleChanged: if (visible) requestPaint()
    onAvailableChanged: if (available) requestPaint()
    Component.onCompleted: requestPaint()

    onPaint: {
        var ctx = getContext("2d")
        ctx.reset()
        var s = Math.min(width, height) / 24.0
        ctx.save()
        ctx.scale(s, s)
        ctx.strokeStyle = root.iconColor
        ctx.fillStyle = root.iconColor
        ctx.lineWidth = root.strokeWidth
        ctx.lineCap = "round"
        ctx.lineJoin = "round"

        var n = root.name
        if (n === "key") {
            ctx.beginPath()
            ctx.arc(8.5, 14.5, 4.5, 0, Math.PI * 2)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(11.8, 11.2)
            ctx.lineTo(20, 3)
            ctx.moveTo(17, 6)
            ctx.lineTo(20, 9)
            ctx.moveTo(14.5, 8.5)
            ctx.lineTo(17, 11)
            ctx.stroke()
        } else if (n === "translate" || n === "globe") {
            ctx.beginPath()
            ctx.arc(12, 12, 8.5, 0, Math.PI * 2)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(3.8, 12)
            ctx.lineTo(20.2, 12)
            ctx.moveTo(12, 3.5)
            ctx.bezierCurveTo(15.2, 7.2, 15.2, 16.8, 12, 20.5)
            ctx.moveTo(12, 3.5)
            ctx.bezierCurveTo(8.8, 7.2, 8.8, 16.8, 12, 20.5)
            ctx.stroke()
        } else if (n === "headphones") {
            ctx.beginPath()
            ctx.arc(12, 12, 8, Math.PI, 0, false)
            ctx.stroke()
            ctx.beginPath()
            ctx.roundedRect(3.5, 12, 3.5, 7, 1.5, 1.5)
            ctx.roundedRect(17, 12, 3.5, 7, 1.5, 1.5)
            ctx.stroke()
        } else if (n === "captions") {
            ctx.beginPath()
            ctx.roundedRect(3, 5, 18, 14, 3, 3)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(7, 14.5)
            ctx.lineTo(12.5, 14.5)
            ctx.moveTo(15, 14.5)
            ctx.lineTo(17, 14.5)
            ctx.moveTo(7, 10.5)
            ctx.lineTo(10, 10.5)
            ctx.moveTo(12.5, 10.5)
            ctx.lineTo(17, 10.5)
            ctx.stroke()
        } else if (n === "volume") {
            ctx.beginPath()
            ctx.moveTo(4, 9.5)
            ctx.lineTo(8, 9.5)
            ctx.lineTo(13, 5.5)
            ctx.lineTo(13, 18.5)
            ctx.lineTo(8, 14.5)
            ctx.lineTo(4, 14.5)
            ctx.closePath()
            ctx.stroke()
            ctx.beginPath()
            ctx.arc(13.5, 12, 3.8, -0.75, 0.75)
            ctx.stroke()
            ctx.beginPath()
            ctx.arc(13.5, 12, 6.8, -0.75, 0.75)
            ctx.stroke()
        } else if (n === "mic") {
            ctx.beginPath()
            ctx.roundedRect(9.2, 3.5, 5.6, 10, 2.8, 2.8)
            ctx.stroke()
            ctx.beginPath()
            ctx.arc(12, 11, 6.2, 0.1, Math.PI - 0.1)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(12, 17.2)
            ctx.lineTo(12, 20.5)
            ctx.moveTo(8.5, 20.5)
            ctx.lineTo(15.5, 20.5)
            ctx.stroke()
        } else if (n === "bolt") {
            ctx.beginPath()
            ctx.moveTo(13.5, 3)
            ctx.lineTo(5.5, 13.5)
            ctx.lineTo(11.5, 13.5)
            ctx.lineTo(10.5, 21)
            ctx.lineTo(18.5, 10.5)
            ctx.lineTo(12.5, 10.5)
            ctx.closePath()
            ctx.stroke()
        } else if (n === "chart" || n === "sliders") {
            ctx.beginPath()
            ctx.moveTo(5, 19)
            ctx.lineTo(5, 13)
            ctx.moveTo(12, 19)
            ctx.lineTo(12, 6)
            ctx.moveTo(19, 19)
            ctx.lineTo(19, 10)
            ctx.stroke()
        } else if (n === "play") {
            ctx.beginPath()
            ctx.moveTo(7.5, 5.5)
            ctx.lineTo(18.5, 12)
            ctx.lineTo(7.5, 18.5)
            ctx.closePath()
            ctx.fill()
        } else if (n === "pause") {
            ctx.beginPath()
            ctx.roundedRect(6.5, 5.5, 3.5, 13, 1, 1)
            ctx.roundedRect(14, 5.5, 3.5, 13, 1, 1)
            ctx.fill()
        } else if (n === "stop") {
            ctx.beginPath()
            ctx.roundedRect(6.5, 6.5, 11, 11, 2, 2)
            ctx.fill()
        } else if (n === "history") {
            ctx.beginPath()
            ctx.arc(12.5, 12, 8, -Math.PI * 0.75, Math.PI * 1.15)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(4.5, 6.5)
            ctx.lineTo(4.5, 10.5)
            ctx.lineTo(8.5, 10.5)
            ctx.moveTo(12.5, 8)
            ctx.lineTo(12.5, 12.2)
            ctx.lineTo(15.5, 14)
            ctx.stroke()
        } else if (n === "settings") {
            ctx.beginPath()
            ctx.moveTo(4, 7)
            ctx.lineTo(20, 7)
            ctx.moveTo(4, 17)
            ctx.lineTo(20, 17)
            ctx.stroke()
            ctx.beginPath()
            ctx.arc(9, 7, 2.3, 0, Math.PI * 2)
            ctx.fill()
            ctx.beginPath()
            ctx.arc(15, 17, 2.3, 0, Math.PI * 2)
            ctx.fill()
        } else if (n === "copy") {
            ctx.beginPath()
            ctx.roundedRect(8.5, 8.5, 11, 11.5, 2, 2)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(5.5, 15.5)
            ctx.lineTo(5.5, 5.5)
            ctx.lineTo(15.5, 5.5)
            ctx.stroke()
        } else if (n === "refresh") {
            ctx.beginPath()
            ctx.arc(12, 12, 7.5, -Math.PI * 0.2, Math.PI * 1.45)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(16.5, 5)
            ctx.lineTo(19.5, 9)
            ctx.lineTo(15, 9.5)
            ctx.stroke()
        } else if (n === "close") {
            ctx.beginPath()
            ctx.moveTo(6.5, 6.5)
            ctx.lineTo(17.5, 17.5)
            ctx.moveTo(17.5, 6.5)
            ctx.lineTo(6.5, 17.5)
            ctx.stroke()
        } else if (n === "external") {
            ctx.beginPath()
            ctx.moveTo(14, 5)
            ctx.lineTo(19, 5)
            ctx.lineTo(19, 10)
            ctx.moveTo(19, 5)
            ctx.lineTo(11, 13)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(17, 13.5)
            ctx.lineTo(17, 18.5)
            ctx.lineTo(5.5, 18.5)
            ctx.lineTo(5.5, 7)
            ctx.lineTo(10.5, 7)
            ctx.stroke()
        } else if (n === "check") {
            ctx.beginPath()
            ctx.moveTo(5.5, 12.5)
            ctx.lineTo(10, 17)
            ctx.lineTo(18.8, 7.5)
            ctx.stroke()
        } else if (n === "warning") {
            ctx.beginPath()
            ctx.arc(12, 12, 8.5, 0, Math.PI * 2)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(12, 8)
            ctx.lineTo(12, 13)
            ctx.moveTo(12, 16.3)
            ctx.lineTo(12, 16.5)
            ctx.stroke()
        } else if (n === "plus") {
            ctx.beginPath()
            ctx.moveTo(12, 5.5)
            ctx.lineTo(12, 18.5)
            ctx.moveTo(5.5, 12)
            ctx.lineTo(18.5, 12)
            ctx.stroke()
        } else if (n === "trash") {
            ctx.beginPath()
            ctx.moveTo(5, 7)
            ctx.lineTo(19, 7)
            ctx.moveTo(9.5, 7)
            ctx.lineTo(9.5, 4.5)
            ctx.lineTo(14.5, 4.5)
            ctx.lineTo(14.5, 7)
            ctx.stroke()
            ctx.beginPath()
            ctx.roundedRect(6.8, 7, 10.4, 12.5, 1.5, 1.5)
            ctx.stroke()
        } else if (n === "arrow_up") {
            ctx.beginPath()
            ctx.moveTo(12, 18.5)
            ctx.lineTo(12, 5.8)
            ctx.moveTo(6.5, 11)
            ctx.lineTo(12, 5.5)
            ctx.lineTo(17.5, 11)
            ctx.stroke()
        } else if (n === "chevron_down") {
            ctx.beginPath()
            ctx.moveTo(6.5, 9.5)
            ctx.lineTo(12, 15)
            ctx.lineTo(17.5, 9.5)
            ctx.stroke()
        } else if (n === "tone") {
            ctx.beginPath()
            ctx.moveTo(4, 12)
            ctx.lineTo(4, 12)
            ctx.moveTo(8, 8)
            ctx.lineTo(8, 16)
            ctx.moveTo(12, 5.5)
            ctx.lineTo(12, 18.5)
            ctx.moveTo(16, 9)
            ctx.lineTo(16, 15)
            ctx.moveTo(20, 11)
            ctx.lineTo(20, 13)
            ctx.stroke()
        } else if (n === "drag") {
            ctx.beginPath()
            ctx.moveTo(12, 4)
            ctx.lineTo(12, 20)
            ctx.moveTo(4, 12)
            ctx.lineTo(20, 12)
            ctx.moveTo(9.5, 6.5)
            ctx.lineTo(12, 4)
            ctx.lineTo(14.5, 6.5)
            ctx.moveTo(9.5, 17.5)
            ctx.lineTo(12, 20)
            ctx.lineTo(14.5, 17.5)
            ctx.moveTo(6.5, 9.5)
            ctx.lineTo(4, 12)
            ctx.lineTo(6.5, 14.5)
            ctx.moveTo(17.5, 9.5)
            ctx.lineTo(20, 12)
            ctx.lineTo(17.5, 14.5)
            ctx.stroke()
        } else if (n === "sidebar_hide") {
            ctx.beginPath()
            ctx.roundedRect(4, 5, 16, 14, 2.5, 2.5)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(9.5, 5)
            ctx.lineTo(9.5, 19)
            ctx.moveTo(15.5, 9.5)
            ctx.lineTo(13, 12)
            ctx.lineTo(15.5, 14.5)
            ctx.stroke()
        } else if (n === "lock") {
            ctx.beginPath()
            ctx.roundedRect(5.5, 11, 13, 9, 2.5, 2.5)
            ctx.stroke()
            ctx.beginPath()
            ctx.arc(12, 8.5, 3.8, Math.PI, 0, false)
            ctx.moveTo(8.2, 8.5)
            ctx.lineTo(8.2, 11)
            ctx.moveTo(15.8, 8.5)
            ctx.lineTo(15.8, 11)
            ctx.stroke()
        } else if (n === "unlock") {
            ctx.beginPath()
            ctx.roundedRect(5.5, 11, 13, 9, 2.5, 2.5)
            ctx.stroke()
            ctx.beginPath()
            ctx.arc(12, 8.2, 3.8, Math.PI, -0.25, false)
            ctx.moveTo(8.2, 8.2)
            ctx.lineTo(8.2, 11)
            ctx.stroke()
        } else if (n === "chevron_up") {
            ctx.beginPath()
            ctx.moveTo(6.5, 14.5)
            ctx.lineTo(12, 9)
            ctx.lineTo(17.5, 14.5)
            ctx.stroke()
        } else if (n === "chat") {
            ctx.beginPath()
            ctx.moveTo(5, 6.5)
            ctx.quadraticCurveTo(5, 5, 6.8, 5)
            ctx.lineTo(17.2, 5)
            ctx.quadraticCurveTo(19, 5, 19, 6.5)
            ctx.lineTo(19, 14.5)
            ctx.quadraticCurveTo(19, 16, 17.2, 16)
            ctx.lineTo(10, 16)
            ctx.lineTo(6.5, 19.2)
            ctx.lineTo(6.5, 16)
            ctx.quadraticCurveTo(5, 16, 5, 14.5)
            ctx.closePath()
            ctx.stroke()
        } else if (n === "sparkles") {
            ctx.beginPath()
            ctx.moveTo(12, 3.5)
            ctx.quadraticCurveTo(12.5, 11.5, 20.5, 12)
            ctx.quadraticCurveTo(12.5, 12.5, 12, 20.5)
            ctx.quadraticCurveTo(11.5, 12.5, 3.5, 12)
            ctx.quadraticCurveTo(11.5, 11.5, 12, 3.5)
            ctx.closePath()
            ctx.stroke()
        } else if (n === "reset") {
            ctx.beginPath()
            ctx.arc(12, 12, 7.5, Math.PI * 0.2, Math.PI * 1.85)
            ctx.stroke()
            ctx.beginPath()
            ctx.moveTo(7.5, 4.8)
            ctx.lineTo(4.5, 8.2)
            ctx.lineTo(8.8, 9)
            ctx.stroke()
        }
        ctx.restore()
    }
}
